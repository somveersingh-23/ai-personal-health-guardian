# Development defaults only. Change POSTGRES_PASSWORD before sharing/deploying.
POSTGRES_DB=health_guardian
POSTGRES_USER=health_user
POSTGRES_PASSWORD=health_password

# Local development when FastAPI runs directly on your computer
DATABASE_URL=postgresql+asyncpg://health_user:health_password@localhost:5432/health_guardian

# Optional integrations; never commit real secrets.
OPENAI_API_KEY=
SECRET_KEY=replace_with_a_long_random_secret
