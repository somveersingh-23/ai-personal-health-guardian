# Member 3 AI Guardian Configuration Example
# Copy this file to .env and configure appropriate values for your environment.
# Never commit active credentials or private keys to source control.

# Database connection URL (PostgreSQL in production, SQLite in local testing)
MEMBER3_DATABASE_URL=

# JWT Authentication Secret (HS256 minimum 32-byte secret)
MEMBER3_JWT_SECRET=

# Webhook Callback Secret for provider delivery receipts
MEMBER3_WEBHOOK_SECRET=

# AI Assistant Provider ('template' for offline prototype, 'openai' for OpenAI Responses API)
MEMBER3_ASSISTANT_PROVIDER=template

# OpenAI Configuration (when MEMBER3_ASSISTANT_PROVIDER=openai)
OPENAI_API_KEY=
MEMBER3_OPENAI_MODEL=gpt-5.4-mini

# FCM Push Notification Configuration (optional)
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=

# Twilio SMS Configuration (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
